<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape
            android:shape="rectangle">
            <solid android:color="#000000" />
            <corners android:radius="26dp" />
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:right="2dp">
        <shape
            android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F5F5F5"
                android:endColor="#FFFFFF"
                android:type="linear" />
            <corners
                android:radius="26dp" />
        </shape>
    </item>

</layer-list>

