<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaginaInicio">


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="330dp"
        android:layout_height="75dp"
        android:layout_gravity="bottom"
        android:background="@drawable/negro_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.972">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/imvBuscar"
                android:layout_width="6dp"
                android:layout_height="25dp"
                android:layout_margin="15dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/inicio" />

            <ImageView
                android:id="@+id/imvFavoritos"
                android:layout_width="6dp"
                android:layout_height="25dp"
                android:layout_margin="15dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/iconfavoritos" />

            <ImageView
                android:id="@+id/imvReservas"
                android:layout_width="6dp"
                android:layout_height="25dp"
                android:layout_margin="15dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/iconreservas" />

            <ImageView
                android:id="@+id/imvPerfil"
                android:layout_width="6dp"
                android:layout_height="25dp"
                android:layout_margin="15dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/iconperfil" />

        </LinearLayout>
    </com.google.android.material.bottomnavigation.BottomNavigationView>

    <ScrollView
        android:layout_width="412dp"
        android:layout_height="730dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView13"
                android:layout_width="282dp"
                android:layout_height="115dp"
                android:fontFamily="@font/poppins"
                android:text="Descubre tu próximo destino"
                android:textSize="32sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvHotel"
                android:layout_width="match_parent"
                android:layout_height="616dp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>

