<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaginaInicio">


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="330dp"
        android:layout_height="75dp"
        android:layout_gravity="bottom"
        android:background="@drawable/negro_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.972">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/imvBuscar"
                android:layout_width="6dp"
                android:layout_height="30dp"
                android:layout_margin="18dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/buscaramarillo" />

            <ImageView
                android:id="@+id/imvFavoritos"
                android:layout_width="6dp"
                android:layout_height="30dp"
                android:layout_margin="18dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/favoritosblanco" />

            <ImageView
                android:id="@+id/imvReservas"
                android:layout_width="6dp"
                android:layout_height="30dp"
                android:layout_margin="18dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/reservablanca" />

            <ImageView
                android:id="@+id/imvPerfil"
                android:layout_width="6dp"
                android:layout_height="30dp"
                android:layout_margin="18dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/perfilblanco" />

        </LinearLayout>
    </com.google.android.material.bottomnavigation.BottomNavigationView>

    <ScrollView
        android:layout_width="335dp"
        android:layout_height="731dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.467"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.137">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView13"
                    android:layout_width="264dp"
                    android:layout_height="115dp"
                    android:fontFamily="@font/poppins"
                    android:text="Descubre                              tu próximo destino"
                    android:textColor="#000000"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="69dp"
                    android:layout_height="71dp"
                    android:layout_weight="1"
                    app:civ_border_color="#FF000000"
                    app:civ_border_width="160dp"
                    app:srcCompat="@drawable/perfilhombrequenoconosco" />
            </LinearLayout>

            <EditText
                android:id="@+id/txtBuscadorHotel"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:background=" #F3F3F3"
                android:backgroundTint=" #F3F3F3"
                android:ems="10"
                android:fontFamily="@font/poppins"
                android:hint="¿A dónde quieres ir?"
                android:inputType="text" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvHotel"
                android:layout_width="match_parent"
                android:layout_height="574dp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>

