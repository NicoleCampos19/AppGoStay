<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"

    app:cardUseCompatPadding="true"
    app:contentPadding="15dp"
    tools:context=".item_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imvFotoHotelDenunciado"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            app:srcCompat="@color/design_default_color_background" />

        <TextView
            android:id="@+id/lblNombreHotelDenunciado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:text="Nombre hotel"
            android:textAlignment="textStart"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:paddingLeft="10dp"
                android:text="Denuncias totales:"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                tools:text="Denuncias totales:" />

            <TextView
                android:id="@+id/lblNumeroDenuncias"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:paddingLeft="2dp"
                android:text="--"
                android:textAlignment="viewStart"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVerDenunciasHotel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:backgroundTint="@color/tuquesa"
            android:fontFamily="@font/poppins"
            android:text="Ver más" />
    </LinearLayout>
</androidx.cardview.widget.CardView>