<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".hotel_detalles">

    <!-- ImageView y TextView que están fuera del ScrollView -->
    <ImageView
        android:id="@+id/imvVolverDetallesHotel"
        android:layout_width="31dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back_blanco"
        app:tint="#000000" />

    <TextView
        android:id="@+id/tvNombreDetalleHotel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:text="@string/Hoteldeta"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/imvVolverDetallesHotel"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- ScrollView que contiene el contenido desplazable -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreDetalleHotel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Contenido del ScrollView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/carrusel_recycler_views"
            android:layout_width="400dp"
            android:layout_height="360dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:radius="700dp"
            android:topLeftRadius="700dp"
            android:topRightRadius="700dp" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="187dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/poppins"
            android:paddingLeft="20dp"
            android:text="@string/servihotel"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvServiciosHotel"
            android:layout_width="match_parent"
            android:layout_height="131dp" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DAD4D4" />

        <TextView
            android:id="@+id/tvDescripcionDetalleHotel"
            android:layout_width="386dp"
            android:layout_height="159dp"
            android:fontFamily="@font/poppins"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:textColor="#000000"
            android:textSize="14dp" />

        <View
            android:id="@+id/view2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DAD4D4" />


        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp" />

        <View
                android:id="@+id/view3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DAD4D4" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView52"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="@color/black"
                android:textSize="15dp"
                android:layout_gravity="center_vertical"
                android:text="@string/valorahotel"
                android:layout_marginLeft="8dp"/>

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="47dp"
                android:layout_gravity="center"
                android:numStars="5"
                android:padding="0dp"
                android:progressBackgroundTint="@color/gris"
                android:progressTint="@color/black"
                android:rating="0"
                android:scaleX="0.4"
                android:scaleY="0.4"
                android:stepSize="1"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/imvEstrella"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/iconoestrella" />

                <TextView
                    android:id="@+id/txtCalificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/txtComentario"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/cuadrito_comentario"
                    android:fontFamily="@font/poppins"
                    android:hint="@string/opinion"
                    android:inputType="text"
                    android:padding="8dp"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/imvEnviar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/iconoenviar" />
            </LinearLayout>

            <TextView
                android:id="@+id/ratingScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text=""
                android:textAlignment="center"/>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvComentarios"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="270dp" />

        <Button
            android:id="@+id/btnMasDetalles"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:text="@string/vermas"
            android:layout_gravity="center"
            android:backgroundTint="@color/white"
            android:textColor="@color/black"
            />

        <View
                android:id="@+id/view4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DAD4D4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imvReportar"
                    android:layout_width="84dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="15dp"
                    android:layout_weight="1"
                    android:paddingTop="8dp"
                    app:srcCompat="@drawable/baseline_flag_24" />

                <Button
                    android:id="@+id/btnReportar"
                    android:layout_width="374dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FDF6FE"
                    android:fontFamily="@font/poppins"
                    android:text="@string/btnReporta"
                    android:textAlignment="textStart"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/view5"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DAD4D4" />

            <Button
                android:id="@+id/btnTipoHabitacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#5CB5C4"
                android:fontFamily="@font/poppinsemibold"
                android:text="@string/eligehabi"
                android:textSize="18sp"
                android:textStyle="bold" />
    </LinearLayout>
    </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>