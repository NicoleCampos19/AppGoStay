             android:max="100"
             android:progress="80"
             android:layout_alignBottom="@id/seekBarMin"
             android:thumb="@drawable/custom_thumb"/>
          android:progressDrawable="@drawable/custom_progress" -->

 </androidx.constraintlayout.widget.ConstraintLayout>

 </ScrollView>